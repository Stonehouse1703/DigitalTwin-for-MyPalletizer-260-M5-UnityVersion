@startuml
!include style.puml
autonumber
hide footbox
scale max 1800 width

actor "Benutzer" as User
participant "Robot" as Robot
participant "MyPalletizerController" as MPC
participant "pymycobot" as PMC
participant "UnityUdpBridge\n(Port 5005)" as UUB
participant "RobotToolManager" as RTM
participant "SuctionPumpController" as SPC
participant "GrabbableObject" as GO

note over User, Robot
Voraussetzung: Zuvor wurde set_end_effector("pump") aufgerufen.
end note

User -> Robot ++ : pump_on()
Robot -> MPC ++ : pump_on()

opt Modus 'virtual' oder 'both'
    MPC ->> UUB : UDP sendto 127.0.0.1:5005\n(type: "pump", enabled: true)
    note right of UUB
    Hintergrund-Thread:
    _commandQueue.Enqueue(cmd)
    end note
end

opt Modus 'real' oder 'both'
    MPC -> PMC : set_basic_output(2, 0)
    MPC -> PMC : set_basic_output(5, 0)
end

MPC --> Robot -- : fertig
Robot --> User -- : Rückkehr

== Unity-Hauptthread (CommandRunner) ==

UUB -> UUB ++ : cmd = _commandQueue.Dequeue()
UUB -> RTM ++ : SetPump(true)

alt CurrentTool == "pump"
    RTM -> SPC ++ : PumpOn()
    SPC -> SPC : IsOn = true, Visuals umschalten
    SPC -> SPC : hits = Physics.OverlapSphere(attachPoint, suctionRadius)
    SPC -> SPC : nächstes GrabbableObject wählen\n(canBePicked und nicht isAttached)
    opt Kandidat gefunden
        SPC -> GO ++ : AttachTo(attachPoint)
        GO -> GO : isKinematic = true, useGravity = false,\nSetParent(attachPoint)
        GO --> SPC -- : Objekt fixiert
    end
    SPC --> RTM -- : fertig
else anderes Werkzeug aktiv
    RTM -> RTM : Warnung, Befehl ignoriert
end

RTM --> UUB -- : fertig
deactivate UUB

@enduml
