@startuml
!include style.puml
skinparam linetype polyline
skinparam nodesep 90
skinparam ranksep 90

actor "Benutzer / Entwickler" as User

package "Digital Twin Gesamtsystem" as DTS {
    component "Python Control Layer\n(mypalletizer API)" as PythonLayer
    component "Unity Simulation Layer\n(Unity 3D / C#)" as UnityLayer
}

node "MyPalletizer 260 M5\n(Physische Hardware)" as Hardware

User -right-> PythonLayer : Python-API
PythonLayer -right-> UnityLayer : UDP / JSON\nPort 5005 (Roboter)\nPort 5006 (Welt)
PythonLayer <-down-> Hardware : USB / Serial\n(Ist-Winkel über get_angles)

@enduml