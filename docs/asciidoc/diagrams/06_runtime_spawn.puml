@startuml
!include style.puml
autonumber
hide footbox
scale max 1800 width

actor "Benutzer" as User
participant "World" as World
participant "protocol" as Proto
participant "WorldUdpBridge\n(Port 5006)" as WUB
participant "Unity Engine\n(Hauptthread)" as Engine
participant "WorldSpawnManager" as WSM

User -> World ++ : spawn(Box("cube1", position=(0.1, 0.2, 0.1), scale=(0.05, 0.05, 0.05)))

World -> World : _validate_object(obj)
World -> Proto ++ : build_spawn_msg("box", "cube1", ...)
Proto --> World -- : dict (type: "spawn")
World ->> WUB : UDP sendto 127.0.0.1:5006 (JSON)
World --> User -- : Rückkehr (Befehl versendet)

note right of WUB
Hintergrund-Thread:
Receive() -> JSON lesen ->
_messageQueue.Enqueue(msg)
(unter lock)
end note

== Unity-Hauptthread (Update-Frame) ==

Engine -> WUB ++ : Update()
loop solange _messageQueue nicht leer
    WUB -> WUB : msg = _messageQueue.Dequeue()
    WUB -> WSM ++ : HandleMessage(msg)
    WSM -> WSM : SpawnObject(msg)
    opt Name existiert bereits
        WSM -> WSM : altes Objekt zerstören
    end
    WSM -> WSM : prefab = GetPrefabByType("box")
    WSM -> Engine ++ : Instantiate(prefab, position, rotation)
    Engine --> WSM -- : GameObject
    WSM -> WSM : Rigidbody konfigurieren,\nGrabbableObject nur bei is_static = false
    WSM -> WSM : Skalierung und Materialfarbe setzen
    WSM -> WSM : _spawnedObjects["cube1"] = GameObject
    WSM --> WUB -- : fertig
end
WUB --> Engine -- : fertig

@enduml
