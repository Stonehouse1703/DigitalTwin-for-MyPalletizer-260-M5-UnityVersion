@startuml
!include style.puml
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 90

package "Unity Simulation Layer" {
    package "Robot Subsystem (Port 5005)" {
        component "UnityUdpBridge\n(Port 5005 Receiver)" as UUB
        component "MyPalletizerArticulationAdapter" as Adapter
        component "ArticulationJointActuator\n(J1 .. J4)" as Actuators
        component "GripperDownConstraint" as DownConstraint
        component "RobotToolManager" as ToolManager
        component "SimpleGripperController" as Gripper
        component "SuctionPumpController" as Pump
        component "RobotLEDController" as LED
    }

    package "World Subsystem (Port 5006)" {
        component "WorldUdpBridge\n(Port 5006 Receiver)" as WUB
        component "WorldSpawnManager" as WSM
        component "GrabbableObject\n(nur dynamische Objekte)" as GO
    }

    package "UI" {
        component "CameraViewManager" as Camera
    }
}

UUB ..> Adapter : move_joints
UUB ..> ToolManager : Werkzeugbefehle
UUB ..> LED : led

Adapter ..> Actuators : steuert (4x)

ToolManager ..> Gripper : Greifen
ToolManager ..> Pump : Saugen

WUB ..> WSM : spawn, delete, clear

WSM ..> GO : fügt hinzu (AddComponent)
Gripper ..> GO : AttachTo / Detach
Pump ..> GO : AttachTo / Detach

note right of DownConstraint
Keine Abhängigkeit zu anderen Bausteinen:
liest nur die Ausrichtung des Eltern-Objekts
(Arm) und hält den Werkzeugkopf damit
senkrecht nach unten.
end note

@enduml
