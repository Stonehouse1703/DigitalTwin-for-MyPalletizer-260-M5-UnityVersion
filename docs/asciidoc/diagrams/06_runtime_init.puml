@startuml
!include style.puml
autonumber
hide footbox

actor "Benutzer" as User
participant "Robot" as Robot
participant "MyPalletizerController" as MPC
participant "World" as World
participant "pymycobot" as PMC

User -> Robot : Robot(mode=BOTH, port="/dev/ttyUSB0")
activate Robot

Robot -> Robot : _validate(config)
activate Robot #EAECEE
deactivate Robot

Robot -> MPC : MyPalletizerController(mode="both", port="/dev/ttyUSB0", ...)
activate MPC

MPC -> PMC : MyPalletizer260("/dev/ttyUSB0", 115200)
activate PMC
PMC --> MPC : Verbindung hergestellt
deactivate PMC

MPC -> PMC : power_on()
activate PMC
deactivate PMC

MPC -> MPC : socket(AF_INET, SOCK_DGRAM) (Port 5005)
activate MPC #EAECEE
deactivate MPC

MPC --> Robot : Controller initialisiert
deactivate MPC

Robot --> User : Robot-Instanz betriebsbereit
deactivate Robot

User -> World : World(ip="127.0.0.1", udp_port=5006)
activate World
World -> World : socket(AF_INET, SOCK_DGRAM)
World --> User : World-Instanz betriebsbereit
deactivate World

@enduml
