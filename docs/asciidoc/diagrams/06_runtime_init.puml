@startuml
!include style.puml
autonumber
hide footbox

actor "Benutzer" as User
participant "Robot" as Robot

User -> Robot ++ : Robot(mode=BOTH, port="/dev/ttyUSB0")

Robot -> Robot : _validate(config)

create participant "MyPalletizerController" as MPC
participant "pymycobot" as PMC
participant "World" as World
Robot -> MPC ++ : <<create>> mode="both", port, ip, udp_port, baudrate

opt Modus 'real' oder 'both'
    MPC -> PMC ++ : MyPalletizer260("/dev/ttyUSB0", 115200)
    PMC --> MPC -- : Objekt (serielle Verbindung offen)
    MPC -> MPC : sleep(2)
    MPC -> PMC ++ : power_on()
    PMC --> MPC -- : ok
    MPC -> MPC : sleep(0.5)
end

opt Modus 'virtual' oder 'both'
    MPC -> MPC : UDP-Socket erzeugen\n(Ziel: 127.0.0.1:5005)
end

MPC --> Robot -- : Controller initialisiert
Robot --> User -- : Robot-Instanz betriebsbereit

User -> World ++ : World(ip="127.0.0.1", udp_port=5006)
World -> World : UDP-Socket erzeugen
World -> World : _validate()
World --> User -- : World-Instanz betriebsbereit

note over User, World
Robot und World sind unabhängig voneinander.
UDP baut keine Verbindung auf: Ob Unity läuft,
wird nicht geprüft.
end note

@enduml
