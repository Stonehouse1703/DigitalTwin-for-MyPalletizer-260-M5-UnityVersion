@startuml
!include style.puml

class World {
    + ip: str
    + udp_port: int
    + sock: Optional[socket]
    __
    + __init__(ip="127.0.0.1", udp_port=5006)
    + spawn(obj: WorldObject)
    + delete(name: str)
    + clear()
    + list_presets() : list[str]
    + load_preset(name: str, clear_first: bool = True)
    + close()
    __
    - _send_udp(payload: dict)
    - _validate()
    - {static} _validate_object(obj: WorldObject)
}

abstract class WorldObject <<dataclass>> {
    + name: str
    + position: Vec3
    + rotation: Vec3 = (0, 0, 0)
    + scale: Vec3 = (1, 1, 1)
    + color: Rgb = (255, 255, 255)
    + is_static: bool = False
    __
    + {abstract} object_type : str <<property>>
}

class Box <<dataclass>> {
    + scale: Vec3 = (0.05, 0.05, 0.05)
    + object_type : str = "box"
}

class Sphere <<dataclass>> {
    + scale: Vec3 = (0.05, 0.05, 0.05)
    + object_type : str = "sphere"
}

class Cylinder <<dataclass>> {
    + scale: Vec3 = (0.05, 0.08, 0.05)
    + object_type : str = "cylinder"
}

class protocol <<module>> {
    + build_spawn_msg(...) : dict
    + build_delete_msg(...) : dict
    + build_clear_msg(...) : dict
}

class presets <<module>> {
    + PRESETS: dict[str, list[WorldObject]]
}

WorldObject <|-- Box
WorldObject <|-- Sphere
WorldObject <|-- Cylinder

World ..> WorldObject : <<use>>
World ..right..> protocol : <<use>>
World ..right..> presets : <<use>>
protocol -[hidden]down- presets
presets o-left- "0..*" WorldObject : PRESETS

@enduml
