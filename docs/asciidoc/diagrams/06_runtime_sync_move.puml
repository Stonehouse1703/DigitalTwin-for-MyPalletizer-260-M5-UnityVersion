@startuml
!include style.puml
autonumber
hide footbox
scale max 1800 width

actor "Benutzer" as User
participant "Robot" as Robot
participant "MyPalletizerController" as MPC
participant "pymycobot" as PMC
participant "UnityUdpBridge\n(Port 5005)" as UUB
participant "Unity Engine\n(Hauptthread)" as Engine
participant "MyPalletizerArticulationAdapter" as Adapter
participant "ArticulationJointActuator\n(J1..J4)" as Act

User -> Robot ++ : sync_move_joints(j1, j2, j3, j4, speed)
Robot -> MPC ++ : sync_move_joints(j1, j2, j3, j4, speed)

MPC -> MPC : _clamp() je Gelenk, _clamp_speed()
MPC -> MPC : _sim_angles = [j1, j2, j3, j4]

opt Modus 'virtual' oder 'both'
    MPC ->> UUB : UDP sendto 127.0.0.1:5005\n(type: "sync_move_joints")
    note right of UUB
    Hintergrund-Thread:
    _commandQueue.Enqueue(cmd)
    end note
end

opt Modus 'real' oder 'both'
    MPC -> PMC ++ : sync_send_angles([j1, j2, j3, j4], speed)
    note right of PMC : Python wartet nur\nauf die Hardware.
    PMC --> MPC -- : Zielposition erreicht
end

MPC --> Robot -- : fertig
Robot --> User -- : Rückkehr

== Unabhängig davon in Unity (Hauptthread) ==

Engine -> UUB ++ : CommandRunner() (Coroutine)
UUB -> UUB : cmd = _commandQueue.Dequeue()
UUB -> Adapter ++ : MoveJointsSync(j1, j2, j3, j4, speed)
Adapter -> Adapter : MoveJointsAsync(...)
Adapter -> Act : MoveToAsync(angle, speed) für J1..J4
loop bis IsAtTarget(Ziel, epsDeg = 0.5) für alle vier Gelenke
    Adapter -> Adapter : yield return WaitForFixedUpdate()
end
Adapter --> UUB -- : alle Gelenke am Ziel
note over UUB
Solange MoveJointsSync wartet, bleibt die
Roboter-Queue blockiert: Folgebefehle (led,
pump, weitere Bewegungen) warten.
end note
UUB --> Engine -- : nächster Queue-Befehl

note over Robot, Engine
Python erhält keine Quittung von Unity
und wartet nicht auf die Simulation.
end note

@enduml
