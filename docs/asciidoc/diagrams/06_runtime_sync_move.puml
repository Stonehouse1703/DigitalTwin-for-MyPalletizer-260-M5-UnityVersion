@startuml
!include style.puml
autonumber
hide footbox
scale max 1800 width

actor "Benutzer" as User
participant "Robot" as Robot
participant "MyPalletizerController" as MPC
participant "pymycobot" as PMC
participant "Unity Simulation" as Unity
participant "UnityUdpBridge" as UUB
participant "MyPalletizerArticulationAdapter" as Adapter

User -> Robot : sync_move_joints(...)
activate Robot

Robot -> MPC : sync_move_joints(...)
activate MPC

MPC -> MPC : _clamp() & _sim_angles aktualisieren

group Simulations-Pfad (UDP Port 5005)
    MPC -> Unity : UDP: sync_move_joints
    activate Unity
    Unity -> UUB : _commandQueue.Enqueue(cmd)
end

group Hardware-Pfad (Serial)
    MPC -> PMC : sync_send_angles(...)
    activate PMC
    note right of MPC : Python wartet nur\nauf die Hardware.
    PMC --> MPC : Hardware-Position erreicht
    deactivate PMC
end

MPC --> Robot : Hardware fertig
deactivate MPC
Robot --> User : Rückkehr (Hardware steht am Ziel)
deactivate Robot

== Unabhängige Verarbeitung in Unity ==
Unity -> UUB : CommandRunner()
activate UUB
UUB -> UUB : cmd = _commandQueue.Dequeue()
UUB -> Adapter : MoveJointsSync(...)
activate Adapter
loop Bis alle Gelenke innerhalb epsDeg (0.5°)
    Adapter -> Adapter : WaitForFixedUpdate()
end
Adapter --> UUB : Alle Achsen am Ziel
deactivate Adapter
UUB --> Unity : Nächster Queue-Befehl freigegeben
deactivate UUB
deactivate Unity

note right of Unity
Python erhält keine Quittung
von Unity.
end note

@enduml
