@startuml
!include style.puml
autonumber

actor "Benutzer" as User
participant "Robot" as Robot
participant "MyPalletizerController" as MPC
participant "pymycobot" as PMC
database "Unity Simulation" as Unity
participant "UnityUdpBridge" as UUB
participant "MyPalletizerArticulationAdapter" as Adapter

User -> Robot : sync_move_joints(j1, j2, j3, j4, speed=40)
activate Robot

Robot -> MPC : sync_move_joints(j1, j2, j3, j4, speed=40)
activate MPC

MPC -> MPC : _clamp() & _sim_angles aktualisieren

group Simulations-Pfad (UDP Port 5005)
    MPC -> Unity : UDP sendto (type: "sync_move_joints")
    activate Unity
    Unity -> UUB : _commandQueue.Enqueue(cmd)
end

group Hardware-Pfad (Serial)
    MPC -> PMC : sync_send_angles([j1, j2, j3, j4], speed)
    activate PMC
    note over MPC, PMC : Blockiert im Python-Thread,\nbis Roboter-Servos am Ziel sind
    PMC --> MPC : Hardware-Position erreicht
    deactivate PMC
end

MPC --> Robot : fertig
deactivate MPC
Robot --> User : Rückkehr (Roboter steht am Ziel)
deactivate Robot

== Synchrone Verarbeitung in Unity ==
Unity -> UUB : CommandRunner()
activate UUB
UUB -> UUB : cmd = _commandQueue.Dequeue()
UUB -> Adapter : yield return MoveJointsSync(j1..j4, speed)
activate Adapter
loop Bis alle Gelenke innerhalb epsDeg (0.5°)
    Adapter -> Adapter : yield return new WaitForFixedUpdate()
end
Adapter --> UUB : Alle Achsen am Ziel
deactivate Adapter
UUB --> Unity : Nächster Queue-Befehl freigegeben
deactivate UUB
deactivate Unity

@enduml
