@startuml
!include style.puml
skinparam linetype polyline
skinparam nodesep 90
skinparam ranksep 90

actor "Benutzer-Skript\n(Python)" as UserScript

rectangle "mypalletizer API\n(Python >= 3.10)" as API
rectangle "Unity Simulation\n(C# / PhysX)" as Unity
rectangle "MyPalletizer 260 M5\n(ESP32)" as Hardware

UserScript -right-> API : Methodenaufrufe\n(Robot, World)
API -right-> Unity : UDP / JSON\nPort 5005 (Roboter)\nPort 5006 (Welt)
API <-down-> Hardware : USB-UART, 115200 Baud\n(Winkel senden,\nget_angles lesen)

note bottom of Unity
Unity sendet keine
Rückmeldung an Python.
end note

@enduml