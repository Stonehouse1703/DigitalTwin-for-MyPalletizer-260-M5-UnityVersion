@startuml
!include style.puml
skinparam linetype polyline
skinparam nodesep 80

node "Host-PC\n(Windows / Linux / macOS)" <<device>> as HostPC {

    node "Python Runtime 3.10+" <<execution environment>> as PyEnv {
        artifact "user_script.py\n(Benutzerskript)" as App
        artifact "mypalletizer-api\n(Python-Paket, Wheel)" as Pkg
        artifact "pymycobot\n(Hersteller-Treiber)" as Driver
    }

    node "Unity Runtime\n(Standalone oder Editor)" <<execution environment>> as UnityEnv {
        artifact "Unity-Simulation\n(.exe / .x86_64 / .app)" as UnityApp
    }
}

node "MyPalletizer 260 M5" <<device>> as HardwareNode {
    node "M5Stack Basic Controller\n(ESP32-Firmware)" <<device>> as Controller
    node "4 Servos (J1..J4) und\nEndeffektoren (Pumpe / Greifer)" <<device>> as Actuators
}

App ..> Pkg : <<use>>
Pkg ..> Driver : <<use>>

Pkg -right- UnityApp : UDP / JSON, Port 5005 (Roboterkanal)
Pkg -right- UnityApp : UDP / JSON, Port 5006 (Weltkanal)

Driver -down- Controller : USB-UART, 115200 Baud, 8N1
Controller -- Actuators : Bus-Signale

@enduml
