@startuml
!include style.puml

node "Host-PC\n(Windows / Linux / macOS)" as HostPC {
    
    artifact "Python 3.10+ Runtime" as PyEnv {
        component "User Application\n(user_script.py)" as App
        component "mypalletizer API\n(Python Package)" as Pkg
        component "pymycobot Driver\n(Hardware-Treiber)" as Driver
    }
    
    artifact "Unity Standalone Application / Editor" as UnityEnv {
        component "Unity 3D Simulation\n(C# Engine / PhysX)" as UnityApp
    }
}

node "MyPalletizer 260 M5 (Hardware)" as HardwareNode {
    component "M5Stack Basic Controller (ESP32 Firmware)" as Controller
    component "4x Servos (J1..J4) &\nEndeffektoren (Pumpe/Greifer)" as Actuators
}

App --> Pkg : API-Methoden
Pkg --> Driver : Interner Treiberaufruf

Pkg --> UnityApp : UDP / JSON \nRoboterkanal
Pkg --> UnityApp : UDP / JSON \nWeltkanal

Driver --> Controller : USB/Serial 
Controller --> Actuators : Bus-Signale

@enduml
